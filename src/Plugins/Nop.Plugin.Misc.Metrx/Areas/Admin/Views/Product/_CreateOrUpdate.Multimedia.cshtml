@model ProductModel

<div class="card-body">
    @if (Model.Id > 0)
    {
        @await Html.PartialAsync("_CreateOrUpdate.Multimedia.Pictures", Model)
    }
    else
    {
        <div class="card card-default">
            <div class="card-body">
                @T("Admin.Catalog.Products.Multimedia.SaveBeforeEdit")
            </div>
        </div>
    }    
</div>