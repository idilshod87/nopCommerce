@using Nop.Plugin.Misc.Metrx
@using Nop.Plugin.Misc.Metrx.Areas.Admin.Models
@model VendorWarehouseModel

@{
    ViewBag.PageTitle = T("Admin.Configuration.Shipping.Warehouses.EditWarehouseDetails").Text;
    NopHtml.SetActiveMenuItemSystemName(MetrxDefaults.VendorWarehousesMenuSystemName);
}

<form asp-controller="VendorWarehouse" asp-action="Edit" method="post">
    <div class="content-header clearfix">
        <h1 class="float-left">
            @T("Admin.Configuration.Shipping.Warehouses.EditWarehouseDetails") - @Model.Name
            <small>
                <i class="fas fa-arrow-circle-left"></i>
                <a asp-action="List">@T("Admin.Configuration.Shipping.Warehouses.BackToList")</a>
            </small>
        </h1>
        <div class="float-right">
            <button type="submit" name="save" class="btn btn-primary">
                <i class="far fa-floppy-disk"></i>
                @T("Admin.Common.Save")
            </button>
            <button type="submit" name="save-continue" class="btn btn-primary">
                <i class="far fa-floppy-disk"></i>
                @T("Admin.Common.SaveContinue")
            </button>
            <span id="vendor-warehouse-delete" class="btn btn-danger">
                <i class="far fa-trash-can"></i>
                @T("Admin.Common.Delete")
            </span>
        </div>
    </div>
    <input type="hidden" asp-for="Id" />
    @await Html.PartialAsync("~/Plugins/Misc.Metrx/Areas/Admin/Views/Shipping/_CreateOrUpdateWarehouse.cshtml", Model)
</form>
<nop-delete-confirmation asp-model-id="@Model.Id" asp-button-id="vendor-warehouse-delete" asp-action="Delete" />
