@model MobileAppSettingsModel
@using Nop.Plugin.Misc.WebApi.Frontend
@using Nop.Plugin.Misc.WebApi.Frontend.Models
@{
    Layout = "_ConfigurePlugin";
    NopHtml.SetActiveMenuItemSystemName(WebApiFrontendDefaults.SystemName);
}

<form asp-controller="WebApiFrontend" asp-action="Configure" method="post">
    <div class="content-header clearfix">
        <h1 class="float-left">
            @T("Plugins.Misc.WebApi.Frontend.Configuration")
        </h1>
        <div class="float-right">
            <button type="submit" name="save" class="btn btn-primary">
                <i class="far fa-save"></i>
                @T("Admin.Common.Save")
            </button>
        </div>
    </div>

    <section class="content">
        <div class="container-fluid">
            <div class="form-horizontal">
                <div class="cards-group">
                    <div class="card card-default">
                        <div class="card-header">
                            <h3 class="card-title">@T("Plugins.Misc.WebApi.Frontend.MobileApp.Settings")</h3>
                        </div>
                        <div class="card-body">
                            <p>@T("Plugins.Misc.WebApi.Frontend.MobileApp.Settings.Description")</p>
                            
                            <div class="form-group row">
                                <div class="col-md-3">
                                    <nop-label asp-for="ShowFeaturedProducts" />
                                </div>
                                <div class="col-md-9">
                                    <nop-editor asp-for="ShowFeaturedProducts" />
                                    <span asp-validation-for="ShowFeaturedProducts"></span>
                                </div>
                            </div>

                            <div class="form-group row">
                                <div class="col-md-3">
                                    <nop-label asp-for="ShowBestsellersOnHomepage" />
                                </div>
                                <div class="col-md-9">
                                    <nop-editor asp-for="ShowBestsellersOnHomepage" />
                                    <span asp-validation-for="ShowBestsellersOnHomepage"></span>
                                </div>
                            </div>

                            <div class="form-group row">
                                <div class="col-md-3">
                                    <nop-label asp-for="ShowHomepageCategoryProducts" />
                                </div>
                                <div class="col-md-9">
                                    <nop-editor asp-for="ShowHomepageCategoryProducts" />
                                    <span asp-validation-for="ShowHomepageCategoryProducts"></span>
                                </div>
                            </div>

                            <div class="form-group row">
                                <div class="col-md-3">
                                    <nop-label asp-for="ShowManufacturers" />
                                </div>
                                <div class="col-md-9">
                                    <nop-editor asp-for="ShowManufacturers" />
                                    <span asp-validation-for="ShowManufacturers"></span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
</form>

